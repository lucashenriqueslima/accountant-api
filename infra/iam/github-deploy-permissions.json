{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubirArtefatos",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::forte-deploy-artifacts-098231071265/*"
    },
    {
      "Sid": "DispararDeploy",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:098231071265:instance/i-0c7db7dd0fff23ad9",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "AcompanharDeploy",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
