{
  "name": "forte-contabilidade",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban para escritórios de contabilidade — Forte Contabilidade",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./api\" --filter \"./app\" dev",
    "dev:api": "pnpm --filter ./api dev",
    "dev:app": "pnpm --filter ./app dev",
    "build": "pnpm --filter ./api build && pnpm --filter ./app build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter ./api prisma:generate",
    "db:migrate": "pnpm --filter ./api prisma:migrate",
    "db:seed": "pnpm --filter ./api prisma:seed",
    "db:seed:boards": "pnpm --filter ./api prisma:seed:boards",
    "db:studio": "pnpm --filter ./api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
