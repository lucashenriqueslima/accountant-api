# Porta da API
PORT=3333

# Origem permitida para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# URL do frontend (usada no link de recuperação de senha)
APP_URL=http://localhost:5173

# Conexão com o MySQL (casa com o docker-compose.yml — usuário root sem senha)
DATABASE_URL="mysql://root@localhost:3306/forte_contabilidade"

# Autenticação JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# ──────────────────────────────────────────────────────────────
# E-mail (SMTP). Em DEV use o MailHog (docker-compose).
# Em PROD use o AWS SES via SMTP:
#   MAIL_HOST=email-smtp.us-east-1.amazonaws.com
#   MAIL_PORT=587
#   MAIL_SECURE=false           # STARTTLS
#   MAIL_USER=<SES SMTP user>
#   MAIL_PASS=<SES SMTP password>
# ──────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Forte Contabilidade <nao-responder@fortecontabilidade.com.br>"

# ──────────────────────────────────────────────────────────────
# Armazenamento de arquivos (documentos de clientes)
# DEV: deixe AWS_S3_BUCKET vazio -> grava em disco em ./api/storage
#      e serve via GET /api/files/<key>.
# PROD: defina AWS_S3_BUCKET + região + credenciais para usar o S3
#       (URLs presigned, expiram em 1h).
# ──────────────────────────────────────────────────────────────
API_PUBLIC_URL=http://localhost:3333
STORAGE_LOCAL_DIR=storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
